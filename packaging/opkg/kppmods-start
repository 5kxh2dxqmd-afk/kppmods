#!/bin/sh
# Call after SDK activation and stock Upstart availability, including after boot.
set -eu
[ "${KPPMOD_DEFER_RELOAD:-0}" != 1 ] || exit 0
umask 022
jobs=/var/run/kppmods-upstart
changed=0
if [ ! -f /etc/upstart/.kppmods ]; then
    mkdir -p "$jobs"
    cp -a /etc/upstart/. "$jobs/"
    touch "$jobs/.kppmods"
    mount --bind "$jobs" /etc/upstart
    changed=1
fi
for job in /var/run/eink-sdk/usr/share/kppmods/upstart/*.conf; do
    [ -f "$job" ] || continue
    target="$jobs/${job##*/}"
    if ! cmp -s "$job" "$target"; then
        cp "$job" "$target.new"
        mv "$target.new" "$target"
        changed=1
    fi
done
if [ "$changed" = 1 ]; then initctl reload-configuration; fi
if ! initctl status kppmods | grep -q start/running; then
    initctl start kppmods
fi
# The service owns activation; start it before issuing a management request.
i=0
until /var/run/eink-sdk/usr/bin/kppmod --request health </dev/null >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || { echo "KPP Mods service did not become ready" >&2; exit 1; }
    sleep 1
done
/var/run/eink-sdk/usr/bin/kppmod reload "$@"
for job in /var/run/eink-sdk/usr/share/kppmods/upstart/*.conf; do
    [ -f "$job" ] || continue
    name=${job##*/}
    name=${name%.conf}
    if ! initctl status "$name" | grep -q start/running; then
        initctl start "$name"
    fi
done
